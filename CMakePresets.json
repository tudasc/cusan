{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "flags-cmake",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "flags-clang",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Wcast-qual -Wshadow -Wformat=2 -Wundef"
      }
    },
    {
      "name": "clang-toolchain",
      "hidden": true,
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "develop",
      "displayName": "Development config (debug)",
      "description": "Default develop build options for Clang",
      "binaryDir": "${sourceDir}/build",
      "inherits": [
        "clang-toolchain", "flags-cmake", "flags-clang"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CUSAN_LOG_LEVEL_RT": "0"
      }
    },
    {
      "name": "develop-container",
      "displayName": "Development container config (debug)",
      "binaryDir": "${sourceDir}/build",
      "inherits": [
        "develop"
      ],
      "cacheVariables": {
        "CUSAN_CONTAINER": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release config",
      "description": "Default release build options for Clang",
      "binaryDir": "${sourceDir}/build",
      "inherits": [
        "clang-toolchain"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CUSAN_LOG_LEVEL_RT": "0"
      }
    },
    {
      "name": "release-container",
      "displayName": "Release container config",
      "binaryDir": "${sourceDir}/build",
      "inherits": [
        "release"
      ],
      "cacheVariables": {
        "CUSAN_CONTAINER": "ON"
      }
    }
  ]
}
